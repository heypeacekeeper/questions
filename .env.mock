# Non-secret fixture environment loaded only by `astro build --mode mock`.
DATA_PROVIDER=mock
ALLOW_MOCK_IN_PRODUCTION=true
ALLOW_DEMO_CONTENT=true
# Prevent Wrangler from automatically loading the owner's root .env.
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VOTER_HASH_SECRET=mock-build-voter-secret-at-least-32-characters
