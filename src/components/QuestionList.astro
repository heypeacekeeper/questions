---
/**
 * Static numbered question list. Pure HTML: no voting, no sharing, no game
 * controls. Numbering continues across pagination via `startIndex`.
 */
import type { Question } from '@/domain/question';

interface Props {
  questions: readonly Question[];
  /** 1-based number of the first row (default 1). */
  startIndex?: number;
  /** Apply rendering containment (below-the-fold long lists only). */
  long?: boolean;
  id?: string;
  ariaLabel?: string;
}
const { questions, startIndex = 1, long = false, id, ariaLabel } = Astro.props;
---

<ol class:list={['question-list', { 'long-list': long }]} id={id} aria-label={ariaLabel} style={startIndex > 1 ? `--list-start:${startIndex - 1}` : undefined} start={startIndex}>
  {questions.map((q) => (
    <li class="question-row">
      <p>Would you rather <b>{q.optionA}</b> or <b>{q.optionB}</b>?</p>
    </li>
  ))}
</ol>
