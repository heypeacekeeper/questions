# ============================================================================
# Would You Rather Questions — environment variables
# Copy to `.env` for local builds. NEVER commit `.env`.
# Cloudflare: non-secret values go in wrangler.jsonc `vars`; secrets via
#   `npx wrangler secret put NAME`.
# Variables prefixed PUBLIC_ may be embedded in HTML/JS. Nothing else may.
# ============================================================================

# --- Site -------------------------------------------------------------------
PUBLIC_SITE_URL=https://wouldyouratherquestions.org

# --- Data provider ------------------------------------------------------------
# supabase (production) | mock (local development / tests only)
DATA_PROVIDER=mock
# Production builds refuse published demo fixtures unless this is true.
ALLOW_DEMO_CONTENT=false

# --- Supabase ----------------------------------------------------------------
# Project URL (Supabase → Project Settings → API)
SUPABASE_URL=
# Secret key — build-time content reads + Worker writes. SERVER ONLY.
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile ---------------------------------------------------
# Public widget key (test key that always passes: 1x00000000000000000000AA)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret key. SERVER ONLY. (test secret: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Analytics --------------------------------------------------------------
FEATURE_GA4=false
PUBLIC_GA4_MEASUREMENT_ID=
FEATURE_CLOUDFLARE_ANALYTICS=false
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# Google Search Console HTML-tag verification content value
PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# --- Advertising (disabled until AdSense approval) --------------------------
FEATURE_ADS=false
PUBLIC_ADSENSE_PUBLISHER_ID=

# --- Feature flags ------------------------------------------------------------
FEATURE_VOTING=true
FEATURE_SUBMISSIONS=true
FEATURE_CONTACT_FORM=true
FEATURE_BLOG=false
FEATURE_SEARCH=false
